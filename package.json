{
  "name": "northmoor-complaints-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "node --experimental-strip-types --disable-warning=ExperimentalWarning data/generator/src/cli.ts",
    "gen:sample": "pnpm gen --sample",
    "build:lambdas": "node --experimental-strip-types --disable-warning=ExperimentalWarning services/api/scripts/build.ts",
    "test-users": "node --experimental-strip-types --disable-warning=ExperimentalWarning services/api/scripts/test-users.ts",
    "check:infra": "sh tools/check-infra.sh",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
